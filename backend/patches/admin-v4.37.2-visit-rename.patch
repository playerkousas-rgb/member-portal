+function normalizeEmailList_(raw) {
+  var seen = {};
+  var valid = [];
+  var invalid = [];
+  String(raw || '').split(/[,，;；\s\r\n]+/).forEach(function (part) {
+    var s = String(part || '').trim();
+    if (!s) return;
+    var key = s.toLowerCase();
+    if (!isValidEmailAddress_(s)) {
+      invalid.push(s);
+      return;
+    }
+    if (!seen[key]) {
+      seen[key] = true;
+      valid.push(s);
+    }
+  });
+  return { valid: valid, invalid: invalid, joined: valid.join(',') };
