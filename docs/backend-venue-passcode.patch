+/** 電話尾4位（密碼第二個位） */
+function phoneTail4_(phone) {
+  var digits = String(phone || '').replace(/\D/g, '');
+  return digits.length >= 4 ? digits.slice(-4) : '';
+}
+
+/** 建碼候選次序：頭4 → 尾4 → 頭4+1…（撞碼後備）。random 模式唔使尾4。 */
+function passcodeCandidates_(phone) {
+  var head = buildKeyboardPwd_(phone);
+  var list = [head];
+  if (phoneSlotLimited_()) {
+    var tail = phoneTail4_(phone);
+    if (tail && tail !== head) list.push(tail);
+  }
+  var cur = head;
+  for (var i = 0; i < 4; i++) {
+    cur = String(parseInt(cur, 10) + 1).padStart(String(cur).length, '0');
+    if (list.indexOf(cur) < 0) list.push(cur);
+  }
+  return list;
+}
+
+/** PWD_MODE 屬 phone4 系（頭4／尾4）先有「同時兩段」限制；random 冇呢個需要 */
+function phoneSlotLimited_() {
+  var mode = String(lockCfg_().pwdMode || 'phone4').toLowerCase();
+  return mode === 'phone4' || mode === 'phone4head' || mode === 'phone4tail';
+}
+
+/** 同一電話而家 pending／approved 而時段未過嘅借用數（時段完＋15 分鐘密碼過期先釋放個位） */
+function countActiveBookingsByPhone_(phone) {
+  var key = String(phone || '').replace(/\D/g, '');
+  if (!key) return 0;
+  var nowMs = Date.now();
+  return readSheet_(SHEET.VENUE_REQ).filter(function (r) {
+    var st = String(r.status || 'pending').toLowerCase();
+    if (st !== 'pending' && st !== 'approved') return false;
+    if (String(r.phone || '').replace(/\D/g, '') !== key) return false;
+    var end = new Date(r.endDate || r.startDate || 0).getTime();
+    return !isNaN(end) && end + 15 * 60 * 1000 >= nowMs;
+  }).length;
+}
+
