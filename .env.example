# 與 scout-district-portal 共用同一個主 Apps Script API Key。
# 請只放在 Vercel / server env，切勿使用 NEXT_PUBLIC_ 前綴。
MEMBER_SKW_APIKEY=

# ── 本機開發選配（production 無效）────────────────────────────
# 將 upstream 指向本地 mock 後台（scout-district-portal `scripts/mock-gs-server.js`）：
#   node /path/to/scout-district-portal/scripts/mock-gs-server.js   # http://127.0.0.1:8788/exec
#   MEMBER_DEV_APIBASE=http://127.0.0.1:8788/exec MEMBER_SKW_APIKEY=dev npm run dev
MEMBER_DEV_APIBASE=
